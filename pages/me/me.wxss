.danger { color: var(--red); }

.plan-cell { align-items: center; }

.stepper {
  display: flex;
  align-items: center;
  background: #EFEFF4;
  border-radius: 16rpx;
  overflow: hidden;
  flex: none;
}
.step {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--blue);
  line-height: 1;
}
.step-input {
  width: 104rpx;
  height: 64rpx;
  text-align: center;
  font-size: 30rpx;
  background: #ffffff;
}

.presets {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
}
.preset {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #EFEFF4;
  color: var(--text2);
  font-size: 26rpx;
}
.preset-on {
  background: rgba(0, 122, 255, 0.12);
  color: var(--blue);
  font-weight: 500;
}
