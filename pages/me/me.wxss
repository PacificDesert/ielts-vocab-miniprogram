.danger { color: var(--red); }

.check { font-size: 34rpx; color: var(--blue); font-weight: 500; }

.plan-cell { align-items: center; }

/* 每组单词数：纯手动输入，不提供预设值 */
.plan-input {
  width: 180rpx;
  height: 72rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
  background: var(--fill);
  color: var(--text);
  border-radius: 16rpx;
  flex: none;
}
.plan-ph { color: var(--text3); font-weight: 400; }
