<view class="page">
  <view class="h1">我的</view>
  <view class="h2">{{stats.learned}} / {{total}} 词已学习 · 正确率 {{stats.accuracy}}%</view>

  <view class="group">
    <view class="card">
      <view class="cell">
        <view class="cell-main"><view class="cell-title">已学单词</view></view>
        <view class="cell-value">{{stats.learned}}</view>
      </view>
      <view class="cell">
        <view class="cell-main"><view class="cell-title">已掌握</view></view>
        <view class="cell-value">{{stats.mastered}}</view>
      </view>
      <view class="cell">
        <view class="cell-main"><view class="cell-title">连续打卡</view></view>
        <view class="cell-value">{{stats.streak}} 天</view>
      </view>
    </view>
  </view>

  <view class="group">
    <view class="group-title">学习计划</view>
    <view class="card">
      <view class="cell plan-cell">
        <view class="cell-main">
          <view class="cell-title">每组单词数</view>
          <view class="cell-sub">{{min}}–{{max}} 之间，可自行修改</view>
        </view>
        <view class="stepper">
          <view class="step" hover-class="btn-hover" bindtap="decPlan">−</view>
          <input
            class="step-input mono"
            type="number"
            value="{{planInput}}"
            bindinput="onPlanInput"
            bindblur="onPlanBlur"
            bindconfirm="onPlanBlur"
          />
          <view class="step" hover-class="btn-hover" bindtap="incPlan">＋</view>
        </view>
      </view>
      <view class="presets">
        <view
          class="preset {{plan.perRound === item ? 'preset-on' : ''}}"
          wx:for="{{presets}}"
          wx:key="*this"
          data-n="{{item}}"
          bindtap="onPreset"
        >{{item}}</view>
      </view>
      <view class="cell">
        <view class="cell-main">
          <view class="cell-title">认识后看拓展</view>
          <view class="cell-sub">标记「认识」后展示书中例句与相近单词</view>
        </view>
        <switch checked="{{plan.showExpand}}" color="#007AFF" bindchange="onToggleExpand" />
      </view>
    </view>
  </view>

  <view class="group">
    <view class="group-title">云端同步（多人使用）</view>
    <view class="card">
      <view class="cell">
        <view class="cell-main">
          <view class="cell-title">云开发环境</view>
          <view class="cell-sub">每位用户的学习进度按 openid 独立存储</view>
        </view>
        <view class="cell-value">{{syncText}}</view>
      </view>
      <view class="cell" bindtap="onPush">
        <view class="cell-main"><view class="cell-title">上传本机进度</view></view>
        <view class="chevron"></view>
      </view>
      <view class="cell" bindtap="onPull">
        <view class="cell-main"><view class="cell-title">拉取云端进度</view></view>
        <view class="chevron"></view>
      </view>
    </view>
  </view>

  <view class="group">
    <view class="card">
      <view class="cell" bindtap="onAbout">
        <view class="cell-main"><view class="cell-title">关于词库</view></view>
        <view class="chevron"></view>
      </view>
      <view class="cell" bindtap="onReset">
        <view class="cell-main"><view class="cell-title danger">重置学习进度</view></view>
      </view>
    </view>
  </view>
</view>
