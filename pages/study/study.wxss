.study { padding-top: 32rpx; }
.bar-head { padding: 0 32rpx 32rpx; }
.bar-text { margin-top: 12rpx; font-size: 24rpx; color: var(--text2); text-align: center; }

.stage { padding: 0 24rpx; }
.stage-card {
  position: relative;
  background: var(--card);
  border-radius: 32rpx;
  min-height: 620rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.stage-art {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  width: 100%;
  height: 100%;
}
.stage-veil {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
}
/* 左上角「上一个单词」标记：小字、不抢主体 */
.stage-prev {
  position: absolute;
  left: 28rpx;
  top: 24rpx;
  right: 28rpx;
  font-size: 20rpx;
  line-height: 1.35;
  text-align: left;
  word-break: break-word;
}
.stage-mono {
  position: absolute;
  right: -20rpx;
  bottom: -100rpx;
  font-size: 380rpx;
  font-weight: 700;
  line-height: 1;
  opacity: 0.12;
}
/* 记忆卡翻面：正面 = 例句卡（例句 + 选释义），背面 = 单词卡（大单词 + 释义） */
.flip-box {
  position: relative;
  width: 100%;
  transform-style: preserve-3d;
  transition: transform 0.5s cubic-bezier(0.42, 0, 0.28, 1);
}
.flip-box.flip-on { transform: rotateY(180deg); }
.flip-face {
  position: relative;
  min-height: 500rpx;
  padding: 60rpx 40rpx;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.flip-back {
  position: absolute;
  left: 0; top: 0; right: 0;
  transform: rotateY(180deg);
}
.stage-word {
  font-size: 76rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  text-align: center;
  word-break: break-word;
}
.stage-ph { font-size: 30rpx; color: var(--text2); margin-top: 16rpx; }

/* 例句卡（正面）：例句是主体，字号比原来更大一档，小喇叭跟着例句走 */
.stage-ex-line {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 12rpx;
  margin-top: 0;
  padding: 0 16rpx;
  max-width: 100%;
}
.stage-ex-t {
  font-size: 34rpx;
  line-height: 1.6;
  font-weight: 500;
  text-align: center;
  word-break: break-word;
}
/* 例句行的小喇叭：只用 CSS 画（不引图片），颜色随卡片正文色走
   命中区比图形本身大一圈，手机上更好点 */
.ex-speak {
  position: relative;
  flex: none;
  width: 46rpx;
  height: 46rpx;
  margin-left: 2rpx;
  touch-action: manipulation;
  transform: translateZ(0);
}
.ex-speak .horn {
  position: absolute;
  left: 6rpx;
  top: 13rpx;
  width: 20rpx;
  height: 20rpx;
}
/* 喇叭底：一个小矩形 */
.horn-body {
  position: absolute;
  left: 0;
  top: 6rpx;
  width: 7rpx;
  height: 8rpx;
  background: currentColor;
  border-radius: 1rpx;
}
/* 喇叭口：向右张开的梯形（用 border 拼） */
.horn-cone {
  position: absolute;
  left: 6rpx;
  top: 0;
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-right: 15rpx solid currentColor;
}
/* 两道声波弧线：border 只留右侧 + 圆角 */
.horn-wave {
  position: absolute;
  border: 2rpx solid currentColor;
  border-left-color: transparent;
  border-top-color: transparent;
  border-bottom-color: transparent;
  border-radius: 50%;
}
.horn-wave.w1 {
  left: 22rpx;
  top: 15rpx;
  width: 14rpx;
  height: 16rpx;
}
.horn-wave.w2 {
  left: 22rpx;
  top: 9rpx;
  width: 26rpx;
  height: 28rpx;
  opacity: 0.72;
}
.ex-speak-hover { opacity: 0.6; }
.ex-speak.on { opacity: 1; }

/* 四个释义选项卡 */
.opts {
  width: 100%;
  margin-top: 44rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.opt {
  width: 100%;
  box-sizing: border-box;
  padding: 26rpx 24rpx;          /* 加大命中区：手机上更好点中 */
  border-radius: 20rpx;
  border: 2rpx solid;
  font-size: 28rpx;
  line-height: 1.45;
  text-align: center;
  word-break: break-word;
  /* 关键：让浏览器不用等「双击缩放」判定，点击立即生效（消除约 300ms 延迟） */
  touch-action: manipulation;
  /* 提到独立合成层，避免点按时因整卡重排而吞掉第一次点击 */
  transform: translateZ(0);
  transition: background-color 0.15s ease, opacity 0.15s ease;
}
/* 只用透明度做点按反馈：不用 scale —— 缩放会让卡片重新排版，
   连续快点时第一次点击容易落空 */
.opt-hover { opacity: 0.6; }
.opt.ok {
  border-color: #34C759 !important;
  background: rgba(52, 199, 89, 0.18);
  color: #1B7A36 !important;
  font-weight: 600;
}
.opt.bad {
  border-color: #FF3B30 !important;
  background: rgba(255, 59, 48, 0.16);
  color: #B3231B !important;
  opacity: 0.95;
}
.stage-line { width: 80rpx; height: 2rpx; background: var(--line); margin: 48rpx 0 32rpx; }
.stage-cn { font-size: 34rpx; line-height: 1.6; text-align: center; }
.stage-ch { font-size: 24rpx; color: var(--text3); margin-top: 24rpx; }
.stage-hint { font-size: 26rpx; color: var(--text3); margin-top: 60rpx; }
/* 翻面时正面选项不要露出（iOS 下 backface 偶发穿透） */
.flip-box.flip-on .flip-face { pointer-events: none; }
.flip-box.flip-on .flip-back { pointer-events: auto; }

.actions { display: flex; gap: 20rpx; padding: 40rpx 24rpx 0; }
.actions .btn { flex: 1; }
/* 还没选出正确释义时，底部不给记熟练度的按钮，避免跳过测验 */
.actions-hint {
  padding: 46rpx 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text3);
}
.gap { margin-top: 20rpx; }

.finish { padding: 120rpx 40rpx 0; text-align: center; }
.finish-title { font-size: 44rpx; font-weight: 600; margin-bottom: 60rpx; }
.finish-row { display: flex; margin-bottom: 80rpx; }
.finish-col { flex: 1; }
.finish-num { font-size: 64rpx; font-weight: 600; }
.finish-num.ok { color: var(--green); }
.finish-num.no { color: var(--red); }
.finish-label { font-size: 26rpx; color: var(--text2); margin-top: 8rpx; }
