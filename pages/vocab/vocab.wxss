.search-wrap { padding: 0 24rpx 24rpx; }
.search {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  background: #E9E9ED;
  border-radius: 20rpx;
}
.search-icon {
  width: 26rpx; height: 26rpx;
  border: 3rpx solid var(--text2);
  border-radius: 50%;
  position: relative;
  margin-right: 16rpx;
  flex: none;
}
.search-icon::after {
  content: '';
  position: absolute;
  right: -10rpx; bottom: -6rpx;
  width: 12rpx; height: 3rpx;
  background: var(--text2);
  transform: rotate(45deg);
}
.search-input { flex: 1; font-size: 30rpx; height: 76rpx; }
.search-ph { color: var(--text2); }
.search-clear { padding: 0 6rpx; font-size: 40rpx; color: var(--text2); line-height: 1; }

.list-head { display: flex; align-items: baseline; padding: 0 32rpx 16rpx; }
.back { font-size: 28rpx; color: var(--blue); margin-right: 20rpx; }
.list-title { font-size: 34rpx; font-weight: 600; }

.word-row {
  display: flex;
  align-items: center;
  padding: 22rpx 32rpx;
  position: relative;
}
.word-row::after {
  content: '';
  position: absolute;
  left: 32rpx; right: 0; bottom: 0;
  height: 1rpx; background: var(--line);
  transform: scaleY(0.5);
}
.word-row:last-child::after { display: none; }
.word-main { flex: 1; min-width: 0; }
.word-line { display: flex; align-items: baseline; }
.word { font-size: 34rpx; font-weight: 500; }
.word-ph { font-size: 24rpx; color: var(--text2); margin-left: 14rpx; }
.word-cn {
  font-size: 26rpx;
  color: var(--text2);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.lv { flex: none; margin-left: 16rpx; }
.lv-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.lv-on { background: var(--green); }
.lv-off { background: var(--orange); }
