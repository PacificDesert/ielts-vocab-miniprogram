.spell { padding-top: 32rpx; }
.bar-head { padding: 0 32rpx 24rpx; }
.bar-text { margin-top: 12rpx; font-size: 24rpx; color: var(--text2); text-align: center; }

.quiz { padding: 40rpx 48rpx 24rpx; text-align: center; }
.quiz-cn { font-size: 40rpx; line-height: 1.5; }
.quiz-mask {
  margin-top: 48rpx;
  font-size: 40rpx;
  letter-spacing: 2rpx;
  color: var(--text3);
  word-break: break-word;
}
.quiz-ph { margin-top: 20rpx; font-size: 28rpx; color: var(--text2); }
.quiz-result { margin-top: 40rpx; font-size: 32rpx; font-weight: 500; }
.quiz-result.ok { color: var(--green); }
.quiz-result.no { color: var(--red); }

.input-wrap { padding: 32rpx 24rpx 0; }
.input {
  height: 104rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 0 32rpx;
  font-size: 36rpx;
  text-align: center;
}
.input-ph { color: var(--text3); font-family: inherit; }

.actions { display: flex; gap: 20rpx; padding: 40rpx 24rpx 0; }
.actions .btn { flex: 1; }

.finish { padding: 140rpx 40rpx 0; text-align: center; }
.finish-title { font-size: 40rpx; font-weight: 600; }
.finish-score { font-size: 88rpx; font-weight: 700; margin-top: 40rpx; }
.finish-label { font-size: 26rpx; color: var(--text2); margin-top: 8rpx; }
.gap { margin-top: 20rpx; }
.gap-lg { margin-top: 80rpx; }
