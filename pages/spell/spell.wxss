.spell { padding-top: 32rpx; }
.bar-head { padding: 0 32rpx 24rpx; }
.bar-text { margin-top: 12rpx; font-size: 24rpx; color: var(--text2); text-align: center; }

/* 题目卡：与记忆卡同款，章节配图 + 渐变遮罩 + 首字母水印 */
.stage { padding: 0 24rpx; }
.stage-card {
  position: relative;
  background: var(--card);
  border-radius: 32rpx;
  min-height: 560rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.stage-art {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  width: 100%;
  height: 100%;
}
.stage-veil {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
}
.stage-mono {
  position: absolute;
  right: -20rpx;
  bottom: -100rpx;
  font-size: 380rpx;
  font-weight: 700;
  line-height: 1;
  opacity: 0.12;
}
/* 左上角「上一个单词」标记（含词形）：小字、不抢主体 */
.stage-prev {
  position: absolute;
  left: 28rpx;
  top: 24rpx;
  right: 28rpx;
  font-size: 20rpx;
  line-height: 1.35;
  text-align: left;
  word-break: break-word;
}

.quiz { position: relative; padding: 100rpx 48rpx 90rpx; text-align: center; }
.quiz-cn { font-size: 40rpx; line-height: 1.5; }
.quiz-mask {
  margin-top: 48rpx;
  font-size: 40rpx;
  letter-spacing: 2rpx;
  color: var(--text2);
  word-break: break-word;
}
.quiz-ph { margin-top: 20rpx; font-size: 28rpx; color: var(--text2); }
/* 题目卡上的小喇叭（图形与记忆卡例句行同一套，颜色走卡片正文色） */
.quiz-speak {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  margin: 24rpx auto 0;
  touch-action: manipulation;
}
.quiz-speak .horn { position: absolute; left: 10rpx; top: 16rpx; width: 24rpx; height: 24rpx; }
.quiz-speak .horn-body {
  position: absolute; left: 0; top: 7rpx;
  width: 8rpx; height: 10rpx; background: currentColor; border-radius: 1rpx;
}
.quiz-speak .horn-cone {
  position: absolute; left: 7rpx; top: 0; width: 0; height: 0;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-right: 18rpx solid currentColor;
}
.quiz-speak .horn-wave {
  position: absolute; border-radius: 50%;
  border: 2rpx solid currentColor;
  border-left-color: transparent;
  border-top-color: transparent;
  border-bottom-color: transparent;
}
.quiz-speak .horn-wave.w1 { left: 29rpx; top: 19rpx; width: 16rpx; height: 18rpx; }
.quiz-speak .horn-wave.w2 { left: 29rpx; top: 12rpx; width: 30rpx; height: 32rpx; opacity: 0.72; }
.quiz-speak.on { opacity: 0.6; }
.quiz-result { margin-top: 40rpx; font-size: 32rpx; font-weight: 500; }
.quiz-result.ok { color: var(--green); }
.quiz-result.no { color: var(--red); }

/* 判定结果的进场动画：正确弹入，错误左右抖一下 */
.pop { animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both; }
.shake { animation: shakeX 0.4s ease-in-out both; }
@keyframes popIn {
  0% { transform: scale(0.6); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
@keyframes shakeX {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-14rpx); }
  40% { transform: translateX(14rpx); }
  60% { transform: translateX(-9rpx); }
  80% { transform: translateX(9rpx); }
}

.input-wrap { padding: 32rpx 24rpx 0; }
.input {
  height: 104rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 0 32rpx;
  font-size: 36rpx;
  text-align: center;
}
.input-ph { color: var(--text3); font-family: inherit; }

.actions { display: flex; gap: 20rpx; padding: 40rpx 24rpx 0; }
.actions .btn { flex: 1; }

.finish { padding: 140rpx 40rpx 0; text-align: center; }
.finish-title { font-size: 40rpx; font-weight: 600; }
.finish-score { font-size: 88rpx; font-weight: 700; margin-top: 40rpx; }
.finish-label { font-size: 26rpx; color: var(--text2); margin-top: 8rpx; }
.gap { margin-top: 20rpx; }
.gap-lg { margin-top: 80rpx; }
