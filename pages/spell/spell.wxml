<view class="page spell">

  <block wx:if="{{!done}}">
    <view class="bar-head">
      <view class="bar">
        <view class="bar-fill" style="width:{{idx / list.length * 100}}%"></view>
      </view>
      <view class="bar-text">{{idx + 1}} / {{list.length}} · 正确 {{right}}</view>
    </view>

    <view class="quiz">
      <view class="quiz-cn">{{cur.cn}}</view>
      <view class="quiz-mask mono">{{mask}}</view>
      <view class="quiz-ph" wx:if="{{checked && cur.ph}}">{{cur.ph}}</view>

      <view class="quiz-result ok" wx:if="{{checked && ok}}">拼写正确</view>
      <view class="quiz-result no" wx:if="{{checked && !ok}}">正确答案：{{cur.w}}</view>
    </view>

    <view class="input-wrap">
      <input
        class="input mono"
        value="{{input}}"
        placeholder="输入英文单词"
        placeholder-class="input-ph"
        confirm-type="done"
        disabled="{{checked}}"
        bindinput="onInput"
        bindconfirm="submit"
      />
    </view>

    <view class="actions">
      <view class="btn btn-plain" wx:if="{{!checked}}" hover-class="btn-hover" bindtap="hint">提示</view>
      <view class="btn btn-plain" wx:if="{{!checked}}" hover-class="btn-hover" bindtap="skip">跳过</view>
      <view class="btn btn-primary" wx:if="{{!checked}}" hover-class="btn-hover" bindtap="submit">提交</view>
      <view class="btn btn-primary" wx:if="{{checked}}" hover-class="btn-hover" bindtap="next">下一题</view>
    </view>
    <view class="copy-link" wx:if="{{checked}}" bindtap="copy">复制单词</view>
  </block>

  <block wx:else>
    <view class="finish">
      <view class="finish-title">本轮完成</view>
      <view class="finish-score">{{right}} / {{right + wrong}}</view>
      <view class="finish-label">拼写正确率 {{acc}}%</view>
      <view class="btn btn-primary btn-block gap-lg" hover-class="btn-hover" bindtap="again">再来一轮</view>
      <view class="btn btn-plain btn-block gap" hover-class="btn-hover" bindtap="goStudy">去记忆单词</view>
      <view class="btn btn-plain btn-block gap" hover-class="btn-hover" bindtap="goHome">返回首页</view>
    </view>
  </block>

</view>
