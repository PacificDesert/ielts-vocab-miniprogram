.expand { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }

/* 单词卡：每个单词都有的一张视觉卡片 */
.wcard {
  position: relative;
  height: 440rpx;
  overflow: hidden;
  background: #E9EDF1;
}
.wcard-art {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  width: 100%;
  height: 100%;
}
.wcard-veil {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
}
.wcard-mono {
  position: absolute;
  right: -24rpx;
  bottom: -110rpx;
  font-size: 420rpx;
  font-weight: 700;
  line-height: 1;
  opacity: 0.13;
}
.wcard-body {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 44rpx;
}
.wcard-tag {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.wcard-word {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  color: #1C1C1E;
  margin-top: 16rpx;
  word-break: break-word;
}
.wcard-foot { display: flex; align-items: center; margin-top: 14rpx; }
.wcard-ph { font-size: 28rpx; color: #6B7280; }
.wcard-speak {
  width: 56rpx;
  height: 56rpx;
  margin-left: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.86);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.speak-icon {
  width: 0;
  height: 0;
  border-left: 20rpx solid var(--blue);
  border-top: 13rpx solid transparent;
  border-bottom: 13rpx solid transparent;
  margin-left: 5rpx;
}

.cn-card { padding: 32rpx; }
.cn { font-size: 34rpx; line-height: 1.6; }
.tags { display: flex; gap: 12rpx; margin-top: 24rpx; }

.ex-card { padding: 32rpx; }
.ex-en { font-size: 32rpx; line-height: 1.6; }
.ex-zh { font-size: 28rpx; color: var(--text2); line-height: 1.6; margin-top: 16rpx; }

.dr-cn { max-width: 60%; text-align: right; }
.sim-word { font-size: 32rpx; font-weight: 500; }
.sim-cn { font-size: 26rpx; color: var(--text2); margin-top: 2rpx; }
.hint { padding: 12rpx 8rpx 0; font-size: 24rpx; color: var(--text3); }
.gap { margin-top: 20rpx; }
