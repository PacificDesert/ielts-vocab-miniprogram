/* 单词意思匹配：左边英文、右边中文，点一对算一次 */
.match { padding-top: 32rpx; }
.bar-head { padding: 0 32rpx 24rpx; }
.bar-text { margin-top: 12rpx; font-size: 24rpx; color: var(--text2); text-align: center; }

.mgrid { display: flex; gap: 20rpx; padding: 8rpx 24rpx 0; }
.mcol { flex: 1; display: flex; flex-direction: column; gap: 20rpx; min-width: 0; }
.mtile {
  min-height: 108rpx;
  padding: 24rpx 18rpx;
  border-radius: 20rpx;
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.mtile-t { font-size: 27rpx; line-height: 1.45; color: var(--text); word-break: break-word; }
.mtile-t.en {
  font-size: 33rpx;
  font-weight: 500;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  word-break: break-word;
}
.mtile-hover { opacity: 0.7; }

/* 选中：蓝框高亮 */
.mtile.picked { box-shadow: inset 0 0 0 4rpx var(--blue); background: var(--blue-soft); }
.mtile.picked .mtile-t { color: var(--blue); }

/* 配对成功：整块变绿并锁定 */
.mtile.ok { background: var(--green); }
.mtile.ok .mtile-t { color: #fff; }

/* 配对失败：整块变红抖一下（不锁定，抖完可重选） */
.mtile.bad { background: var(--red); animation: shake 0.5s ease-in-out; }
.mtile.bad .mtile-t { color: #fff; }

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-14rpx); }
  45% { transform: translateX(12rpx); }
  70% { transform: translateX(-8rpx); }
}

.mtip { padding: 28rpx 32rpx 0; text-align: center; font-size: 24rpx; color: var(--text3); }

.finish { padding: 110rpx 40rpx 0; text-align: center; }
.finish-title { font-size: 44rpx; font-weight: 600; margin-bottom: 56rpx; }
.finish-row { display: flex; margin-bottom: 24rpx; }
.finish-col { flex: 1; }
.finish-num { font-size: 64rpx; font-weight: 600; }
.finish-num.ok { color: var(--green); }
.finish-num.no { color: var(--red); }
.finish-label { font-size: 26rpx; color: var(--text2); margin-top: 8rpx; }
.finish-acc { font-size: 28rpx; color: var(--text2); margin-bottom: 56rpx; }
.gap { margin-top: 20rpx; }
