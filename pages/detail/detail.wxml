<view class="page detail {{themeClass}}">

  <view class="turn-wrap {{turn}}">
    <view class="wcard">
      <image class="wcard-art" src="{{card.img}}" mode="aspectFill" wx:if="{{card.img}}" lazy-load="{{true}}" />
      <view class="wcard-veil" style="background:{{card.veil}}"></view>
      <view class="wcard-mono" style="color:{{card.ink}}">{{card.mono}}</view>
      <view class="wcard-body">
        <view class="wcard-tag" style="color:{{card.ink}};background:{{card.tint}}">{{ch}}</view>
        <view class="wcard-word">{{w}}</view>
        <view class="wcard-foot">
          <text class="wcard-ph" wx:if="{{ph}}">{{ph}}</text>
          <view class="wcard-speak" wx:if="{{canSpeak}}" hover-class="btn-hover" catchtap="play">
            <view class="speak-icon"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="group" style="margin-top:24rpx">
      <view class="group-title">释义</view>
      <view class="card cn-card">
        <text class="cn">{{cn}}</text>
        <view class="tags">
          <text class="tag" wx:if="{{lv >= 3}}">已掌握</text>
          <text class="tag" wx:elif="{{lv > 0}}">复习中</text>
          <text class="tag" wx:else>未学习</text>
        </view>
      </view>
    </view>

    <view class="group" wx:if="{{ex}}">
      <view class="group-title">书中例句<text class="group-hint" wx:if="{{exToks.length}}">点单词查释义</text></view>
      <view class="card ex-card">
        <view class="ex-en">
          <block wx:for="{{exToks}}" wx:key="index">
            <text wx:if="{{!item.w}}" class="ex-tok">{{item.t}}</text>
            <text wx:elif="{{item.bold}}" class="ex-tok ex-bold">{{item.t}}</text>
            <text wx:elif="{{item.it}}" class="ex-tok ex-hit" data-i="{{index}}" catchtap="onExWord">{{item.t}}</text>
            <text wx:else class="ex-tok ex-plain" data-i="{{index}}" catchtap="onExWord">{{item.t}}</text>
          </block>
        </view>
        <view class="ex-zh" wx:if="{{ex.zh}}">{{ex.zh}}</view>
      </view>
    </view>

    <view class="group" wx:if="{{dr.length}}">
      <view class="group-title">词形拓展</view>
      <view class="card">
        <view class="cell" wx:for="{{dr}}" wx:key="0">
          <view class="cell-main"><view class="cell-title">{{item[0]}}</view></view>
          <view class="cell-value dr-cn">{{item[1]}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="group">
    <view class="btn-row">
      <view class="btn btn-plain" hover-class="btn-hover" bindtap="onExpand">相近词</view>
      <view class="btn btn-plain" hover-class="btn-hover" bindtap="markUnknown">不认识</view>
      <view class="btn btn-ghost" hover-class="btn-hover" bindtap="markKnown">认识</view>
    </view>
  </view>

  <view class="pager">
    <view class="pager-btn" hover-class="btn-hover" bindtap="prev">‹ 上一个</view>
    <view class="pager-idx">{{index + 1}} / {{total}}</view>
    <view class="pager-btn" hover-class="btn-hover" bindtap="next">下一个 ›</view>
  </view>

  <!-- 例句点词弹层 -->
  <view class="pop-mask" wx:if="{{popWord}}" bindtap="closePop">
    <view class="pop" catchtap="noop">
      <view class="pop-head">
        <view class="pop-title">{{popWord.w}}</view>
        <view class="pop-speak" wx:if="{{canSpeak}}" hover-class="btn-hover" catchtap="popSpeak">
          <view class="speak-icon"></view>
        </view>
      </view>
      <view class="pop-ph" wx:if="{{popWord.ph}}">{{popWord.ph}}</view>
      <view class="pop-cn">{{popWord.cn}}</view>
      <view class="pop-ex" wx:if="{{popWord.ex}}">
        <view class="pop-ex-en">{{popWord.ex}}</view>
        <view class="pop-ex-zh" wx:if="{{popWord.exZh}}">{{popWord.exZh}}</view>
      </view>
      <view class="pop-actions">
        <view class="pop-btn" hover-class="btn-hover" bindtap="closePop">关闭</view>
        <view class="pop-btn pop-btn-main" hover-class="btn-hover" bindtap="popDetail">查看详情</view>
      </view>
    </view>
  </view>
</view>
