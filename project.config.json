{
  "description": "雅思词汇 · 微信小程序（云开发后端）",
  "appid": "touristappid",
  "projectname": "ielts-vocab",
  "compileType": "miniprogram",
  "libVersion": "3.5.5",
  "cloudfunctionRoot": "cloudfunctions/",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "ignoreDevUnusedFiles": false,
    "packNpmManually": false
  },
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "preview" },
      { "type": "folder", "value": "tools" },
      { "type": "folder", "value": "cloudfunctions" },
      { "type": "file", "value": "README.md" },
      { "type": "file", "value": "LICENSE" },
      { "type": "file", "value": ".gitignore" },
      { "type": "file", "value": ".gitattributes" }
    ]
  },
  "condition": {}
}
